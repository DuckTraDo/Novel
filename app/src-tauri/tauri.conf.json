{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sodarie Novel",
  "version": "0.3.0",
  "identifier": "com.yuxin.novel-pipeline",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sodarie Novel",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "templates/config.yaml",
      "templates/memory/*",
      "templates/outlines/*"
    ]
  }
}
